FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN apt-get update && apt-get install -y --no-install-recommends git libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 1000 --create-home app
WORKDIR /app
COPY deploy/runtime-cpu.lock /app/deploy/runtime-cpu.lock
RUN pip install --no-cache-dir uv==0.11.7 && uv pip sync --system --torch-backend cpu /app/deploy/runtime-cpu.lock
COPY pipeline /app/pipeline
COPY training /app/training
COPY mlops /app/mlops
COPY configs /app/configs
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 MPLBACKEND=Agg MPLCONFIGDIR=/tmp/matplotlib XDG_CACHE_HOME=/tmp/cache TORCH_HOME=/tmp/torch TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor YOLO_CONFIG_DIR=/tmp
USER app
ENTRYPOINT ["python", "-m", "pipeline"]
